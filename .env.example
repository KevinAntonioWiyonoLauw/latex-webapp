# Konfigurasi LaTeX Web Editor.
# Salin file ini ke .env lalu sesuaikan bila perlu.

# ============================================================================
#  PENGEMBANGAN LOKAL (bun run dev)
# ============================================================================
PORT=5174
HOST=127.0.0.1
NODE_ENV=development

# Path binary tectonic (default: tools/tectonic.exe)
# TECTONIC_BIN=G:\Project\latex\tools\tectonic.exe

# Timeout compile (ms)
COMPILE_TIMEOUT_MS=120000

# Batas ukuran upload (bytes) - default 100MB
MAX_UPLOAD_BYTES=104857600

# Lokasi penyimpanan project (disk)
# LATEX_DATA_DIR=G:\Project\latex\server\data\projects

# ----------------------------- Database ------------------------------
DATABASE_URL=postgres://latex:***@127.0.0.1:5437/latex

# ------------------------------- Redis -------------------------------
REDIS_URL=redis://127.0.0.1:6381

# ------------------------------- Auth --------------------------------
BETTER_AUTH_SECRET=ubah-ini-menjadi-string-acak-panjang-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# OAuth Google (opsional; kosongkan bila belum dipakai)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth GitHub (opsional; kosongkan bila belum dipakai)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------- Collab --------------------------------
COLLAB_PORT=1234
COLLAB_URL=ws://127.0.0.1:1234

# ============================================================================
#  PRODUKSI / HOMELAB (docker-compose.prod.yml, deploy via Portainer)
# ============================================================================
# Domain publik. TLS + routing ditangani Traefik (bukan Caddy).
# DOMAIN=latex.kevinio.my.id

# Kredensial Postgres produksi (WAJIB diisi).
# POSTGRES_USER=latex
# POSTGRES_PASSWORD=ganti-password-kuat
# POSTGRES_DB=latex

# Secret Better Auth — generate: openssl rand -hex 32
# BETTER_AUTH_SECRET=ganti-string-acak-minimal-32-karakter

# Lokasi data di host (bind-mount). Dokumen user tersimpan di sini,
# jadi backup cukup meng-copy folder ini.
# LATEX_DATA_PATH=/opt/latex-webapp/data

# Paksa flag Secure pada cookie auth. Default sudah `true` dan itu yang benar
# untuk akses via HTTPS (Cloudflare). Hanya set `false` bila menguji di HTTP polos.
# COOKIE_SECURE=true

# Zona waktu container
# TZ=Asia/Jakarta

# Override tag image GHCR (default: :latest). Berguna untuk pin versi
# atau rollback, mis. :sha-a1b2c3d atau :1.0.0
# LATEX_IMAGE_SERVER=ghcr.io/kevinantoniowiyonolauw/latex-webapp-server:latest
# LATEX_IMAGE_COLLAB=ghcr.io/kevinantoniowiyonolauw/latex-webapp-collab:latest
# LATEX_IMAGE_WEB=ghcr.io/kevinantoniowiyonolauw/latex-webapp-web:latest
